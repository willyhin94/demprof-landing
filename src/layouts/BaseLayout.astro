---
import '../styles/globals.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DemProf — ремонт квартир под ключ в Москве',
  description = 'Полный ремонт квартир. Бесплатный замер, фиксированная смета, гарантия 2 года. Более 15 лет опыта.',
} = Astro.props;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'DemProf',
  description: 'Компания по ремонту квартир с полным спектром услуг',
  url: 'https://demprof.ru',
  telephone: '+7-XXX-XXX-XXXX',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'RU',
    addressLocality: 'Москва',
  },
});
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="ремонт квартир, капитальный ремонт, дизайн квартиры, ремонт в новостройке" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content="https://demprof.ru" />
    <meta property="og:title" content="DemProf — ремонт квартир под ключ" />
    <meta property="og:description" content="Полный ремонт квартир с гарантией. Бесплатный замер и смета за 1 день." />
    <meta property="og:site_name" content="DemProf" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="DemProf" />
    <meta name="twitter:description" content="Ремонт квартир под ключ" />
    <link rel="icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
</html>
