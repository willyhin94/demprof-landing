---
const guar = [
  {
    id: 1,
    title: 'Официальный договор',
    description: 'Письменное соглашение с описанием работ, материалов и сроков.',
    icon: '📜',
  },
  {
    id: 2,
    title: 'Гарантия на все виды работ',
    description: 'Если что-то не сработает в первые 2 года — переделаем бесплатно.',
    icon: '🏅',
  },
  {
    id: 3,
    title: 'Ответственность за сроки',
    description: 'Срыв графика — штраф. Мы доводим проект до конца.',
    icon: '⚖️',
  },
]
---
<section id="guarantees" class="py-16 px-4 sm:px-6 lg:px-8 bg-dark text-white">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-4xl font-extrabold mb-12 text-center">
      Гарантии и ответственность
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {guar.map((g) => (
        <div
          key={g.id}
          class="p-6 bg-dark border-2 border-white rounded-lg"
        >
          <div class="text-4xl mb-4">{g.icon}</div>
          <h3 class="text-xl font-bold mb-3">
            {g.title}
          </h3>
          <p class="text-gray-300">
            {g.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
