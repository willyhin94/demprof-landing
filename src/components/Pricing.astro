---
const PACKAGES = [
  { id: 1, title: 'Косметический ремонт', price: '2500-4000', duration: 'до 1 месяца', popular: false, features: ['Окраска стен и потолка', 'Замена полов', 'Замена плинтусов и дверей', 'Уборка после работ'] },
  { id: 2, title: 'Капитальный ремонт', price: '5000-8000', duration: '2-3 месяца', popular: false, features: ['Полная переделка электрики', 'Замена водопровода', 'Выравнивание стен', 'Новые полы и отделка'] },
  { id: 3, title: 'Ремонт под ключ', price: '8000-12000', duration: 'от 6 месяцев', popular: true, features: ['Всё из капитального + дизайн-проект', 'Подбор материалов и мебели', 'Авторский надзор', 'Финальная уборка и расстановка'] },
  { id: 4, title: 'Ремонт в новостройке', price: '3500-6000', duration: '2-4 месяца', popular: false, features: ['Черновые работы', 'Чистовая отделка', 'Установка сантехники', 'Финальная уборка'] },
]
---
<section id="pricing" class="py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-4xl font-extrabold text-dark mb-12 text-center">Стоимость услуг</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {PACKAGES.map((pkg) => (
        <div key={pkg.id} class={`relative p-8 rounded-lg border-2 transition-all ${pkg.popular ? 'border-primary bg-primary/5 shadow-lg' : 'border-dark bg-white'}`}>
          {pkg.popular && <div class="absolute -top-4 left-8 px-4 py-1 bg-primary text-white text-sm font-bold rounded-full">⭐ Популярный выбор</div>}
          <h3 class="text-2xl font-bold text-dark mb-2">{pkg.title}</h3>
          <div class="mb-6"><div class="text-4xl font-extrabold text-primary mb-1">{pkg.price}₽</div><p class="text-sm text-gray-600">за м²</p></div>
          <div class="mb-6"><p class="text-sm text-gray-600"><strong>Сроки:</strong> {pkg.duration}</p></div>
          <div class="mb-8"><p class="text-sm font-bold text-dark mb-3">Включает:</p><ul class="space-y-2">{pkg.features.map((f, i) => <li key={i} class="flex gap-2 text-sm"><span class="text-success flex-shrink-0">✓</span><span class="text-gray-600">{f}</span></li>)}</ul></div>
          <a href="https://t.me/ndemidov_portfolio" target="_blank" rel="noopener noreferrer" class={`block w-full px-4 py-3 font-bold rounded-md text-center transition-opacity hover:opacity-90 ${pkg.popular ? 'bg-primary text-white' : 'bg-dark text-white'}`}>Рассчитать точно</a>
        </div>
      ))}
    </div>
    <div class="mt-12 p-6 bg-white border-2 border-dark rounded-lg">
      <p class="text-sm text-gray-600">Цены указаны за работу без учёта стоимости материалов. Точная стоимость определяется после обсуждения всех деталей.</p>
    </div>
  </div>
</section>
